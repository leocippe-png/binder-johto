rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leo: l'unico utente con email e password, riconosciuto dal suo UID
    function leo() { return request.auth != null && request.auth.uid == "SvNboXHbUnNilhE40d3hB6wNIsF3"; }

    // stato delle tasche e date di arrivo: tutti leggono, solo Leo scrive
    match /binder/{doc} {
      allow read: if true;
      allow write: if leo();
    }
    // prezzi, priorità e note della mancolista: solo Leo
    match /privato/{doc} {
      allow read, write: if leo();
    }
    // immagini caricate da Leo per le tasche (una per documento): tutti le vedono, solo Leo le carica
    match /stampe/{id} {
      allow read: if true;
      allow delete: if leo();
      allow create, update: if leo() && request.resource.data.img is string && request.resource.data.img.size() < 1000000;
    }
    // messaggi degli amici: chiunque li manda (accesso anonimo); Leo li gestisce, ognuno rilegge i propri con la risposta di Leo
    match /messaggi/{id} {
      allow read: if leo() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if leo();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['kind','slot','slots','from','text','ts','status','fonte','uid'])
        && request.resource.data.kind in ['offerta','suggerimento','commento']
        && request.resource.data.text is string && request.resource.data.text.size() <= 1500
        && request.resource.data.from is string && request.resource.data.from.size() <= 40
        && request.resource.data.status == 'nuova'
        && request.resource.data.uid == request.auth.uid;
    }
  }
}
